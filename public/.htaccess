# Single-page app on Apache (Hostinger).
#
# The nav writes real paths into the address bar — /treatments, /about,
# /results, /reviews, /faq, /thank-you — but only index.html exists on disk.
# That is fine while the visitor stays in the tab, because those paths are
# pushed by history.pushState and never requested from the server. The moment
# someone refreshes, opens one in a new tab, or follows a shared link, Apache
# is asked for a file that is not there and answers 404.
#
# This hands those requests to index.html and lets the app scroll to the
# matching section on load. Real files and directories are served untouched, so
# /api/email.php, the assets and the favicons are unaffected.
#
# The list is exhaustive on purpose. A blanket `RewriteRule . /index.html`
# answers *every* URL with the homepage — /skin, /no, /anything-at-all all
# returned the full site with a 200, which means a typo looks like a real page,
# and search engines index unlimited duplicate URLs. Anything not named here now
# falls through to Apache, which finds no file and serves 404.html with a real
# 404 status. Add a path here only when the app can actually route to it.

# ⚠ THE PATHS BELOW MUST MATCH `base` IN vite.config.js. The build writes asset
# URLs under that base; these rules answer requests under it. Change one without
# the other and the site either 404s its bundle (white page) or 404s its paths.
# Currently /skin/ — this deploys into a `skin/` folder beside the hair site's
# `hair/`. Moving it to public_html or a subdomain root means `/` in both files.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /skin/

  # Anything that exists on disk wins — assets, images, and the PHP handler.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Leave the API alone even if a file is ever missing, so a broken endpoint
  # returns a 404 rather than silently serving the site's HTML to a fetch().
  RewriteRule ^api/ - [L]

  # The section ids the nav writes with pushState (see useCleanAnchors), plus
  # the path the lead form pushes on success.
  RewriteRule ^(top|about|results|treatments|reviews|faq|book|consultation|thank-you)/?$ /skin/index.html [L]
</IfModule>

# Everything else. Without this Apache answers with its own bare error page.
ErrorDocument 404 /skin/404.html

# Hashed filenames from the build are safe to cache hard; index.html must not
# be, or a deploy leaves visitors on the previous bundle.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpe?g|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
